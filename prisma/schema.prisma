generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  color       String
  icon        String
  hasAccounts Boolean  @default(false)
  createdAt   DateTime @default(now())

  accounts  Account[]
  groups    Group[]
  configs   Config[]
  tasks     Task[]
}

model Group {
  id           String    @id @default(cuid())
  name         String
  industry     String
  description  String?
  departmentId String
  createdAt    DateTime  @default(now())

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  accounts     Account[]

  @@unique([name, departmentId])
}

model Account {
  id           String   @id @default(cuid())
  name         String
  industry     String
  segment      String
  owner        String
  location     String?
  website      String?
  description  String?
  groupId      String?
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  group         Group?        @relation(fields: [groupId], references: [id])
  contacts      Contact[]
  tasks         Task[]
  opportunities Opportunity[]
  pastProjects  PastProject[]
}

model Contact {
  id        String  @id @default(cuid())
  name      String
  role      String?
  email     String?
  phone     String?
  whatsapp  Boolean @default(false)
  isPrimary Boolean @default(false)
  notes     String?
  createdAt DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String
  status      String
  dueDate     DateTime?
  assignee    String?
  category    String?
  comments    String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accountId    String?
  departmentId String?
  account      Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id          String    @id @default(cuid())
  title       String
  stage       String
  value       Float     @default(0)
  probability Int       @default(25)
  closeDate   DateTime?
  notes       String?
  nextStep    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model PastProject {
  id          String   @id @default(cuid())
  name        String
  revenue     Float    @default(0)
  year        Int
  description String?
  createdAt   DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Config {
  id           String     @id @default(cuid())
  key          String
  values       String[]
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([key, departmentId])
}
